include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include .pre-commit-hooks.yaml
recursive-include docs *.md
recursive-include examples *.yaml
recursive-include scripts *.py
recursive-include tests *.py
prune .github
prune .agent-sessions
prune .git
prune .venv
global-exclude *.py[cod] .DS_Store .env .env.*
